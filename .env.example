# Select exactly one first-pass family. This profile is for MOSS on gpu18.
ASR_BACKEND=moss-transcribe-diarize
MOSS_TRANSCRIBE_URL=http://127.0.0.1:8010/v1/audio/transcriptions
MOSS_MODEL_PATH=/home/panyibo/models/openmoss/MOSS-Transcribe-Diarize
MOSS_MODEL_NAME=MOSS-Transcribe-Diarize
MOSS_MAX_COMPLETION_TOKENS=32768
MOSS_MIN_COVERAGE_RATIO=0.98
ASR_JUDGE_WINDOW_MAX_TURNS=10
ASR_JUDGE_WINDOW_MAX_CHARS=180
ASR_JUDGE_WINDOW_MAX_AUDIO_SEC=30
ASR_EXPERIMENT_NAMESPACE=aishell4-moss-test20

# Qwen-Omni alternative. Do not enable it in a MOSS experiment.
ASR_AUDIO_ENABLED=0
ASR_MODEL_PATH=/path/to/qwen-omni-checkpoint
ASR_AUDIO_DIR=/path/to/audio
ASR_GPU=0,1
ASR_MAX_MODEL_LEN=4096
ASR_MAX_TOKENS=512
ASR_GPU_MEM_UTIL=0.85
ASR_MAX_NUM_SEQS=1
ASR_ENFORCE_EAGER=1
ASR_CHUNK_MAX_SEC=30
ASR_CHUNK_OVERLAP_SEC=0.5
ASR_PROMPT_MODE=plain
ASR_UNCERTAINTY_DISCOVERY=1
ASR_ACOUSTIC_DISAGREEMENT=1
# Correctness baseline: every MOSS turn reaches contextual candidate analysis.
# Enable only for a separately measured latency experiment.
ASR_FAST_NORMAL_TURNS=0
ASR_MEMORY_RECENT_LIMIT=16
# Long-term memory is shared across audio sessions for the same backend/model
# inside this namespace. Changing either the model identity or namespace starts
# a fresh isolated memory scope; legacy per-session memory is not auto-migrated.
ASR_HISTORY_DIGEST_CHARS=120

# Optional Agent evidence tool. It is only called after deterministic evidence is insufficient.
# Public HTTP DeepSeek:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
#
# Huawei AccessService websocket gateway (test_ds31.py):
# LLM_TRANSPORT=websocket
# LLM_WS_URL=ws://10.32.101.24:18087/llm/websocket/openai/chat/completions
# LLM_WS_USER=
# LLM_WS_SENDER=
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash/Cluster-1
