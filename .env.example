# Qwen-Omni audio observation adapter. Configure these on the GPU server only.
ASR_AUDIO_ENABLED=0
ASR_MODEL_PATH=/path/to/qwen-omni-checkpoint
ASR_AUDIO_DIR=/path/to/audio
ASR_GPU=0
ASR_MAX_MODEL_LEN=4096
ASR_MAX_TOKENS=512
ASR_GPU_MEM_UTIL=0.85
ASR_MAX_NUM_SEQS=1
ASR_ENFORCE_EAGER=1
ASR_CHUNK_MAX_SEC=15
ASR_CHUNK_OVERLAP_SEC=0.3

# Optional Agent evidence tool. It is only called after deterministic evidence is insufficient.
# Public HTTP DeepSeek:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
#
# Huawei AccessService websocket gateway (test_ds31.py):
LLM_TRANSPORT=websocket
LLM_WS_URL=ws://10.32.101.24:18087/llm/websocket/openai/chat/completions
DEEPSEEK_API_KEY=AccessService
LLM_WS_USER=
LLM_WS_SENDER=
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash/Cluster-1
