# Point to sibling ASR_domainterms (DeepSeek WS / HTTP client lives there)
ASR_DOMAINTERMS_ROOT=/path/to/ASR_domainterms

# Qwen-Omni two-pass (ms-swift + vLLM). Prefer conda PyTorch env + bash run_server.sh.
ASR_AUDIO_ENABLED=1
ASR_MODEL_PATH=/path/to/qwen-omni-checkpoint
ASR_AUDIO_DIR=/path/to/audio_dir
ASR_GPU=0
ASR_GPU_MEM_UTIL=0.85
ASR_MAX_MODEL_LEN=4096
ASR_MAX_NUM_SEQS=1
ASR_ENFORCE_EAGER=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ASR_CHUNK_MAX_SEC=15
ASR_CHUNK_OVERLAP_SEC=0.3
ASR_CHUNK_MIN_SEC=0.4
ASR_CHUNK_TOP_DB=30
ASR_EVOLVE_MAX_ITERS=3
ASR_EVOLVE_MAX_TERMS=20
